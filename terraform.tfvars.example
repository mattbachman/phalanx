# Example terraform.tfvars file
# Copy this file to terraform.tfvars and update with your values

project_id = "your-gcp-project-id"
region     = "us-central1"
zone       = "us-central1-a"

# Optional: Customize VM names
# vm_names = ["rhel9-vm-1", "rhel9-vm-2"]

# Optional: Change machine type
# machine_type = "e2-medium"

# Optional: Change boot disk size (in GB)
# boot_disk_size = 20

# Optional: Add network tags
# tags = ["rhel9", "web"]
